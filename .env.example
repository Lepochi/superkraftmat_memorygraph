# Environment Configuration
NODE_ENV=development
PORT=8000

# Memory System Configuration
MEMORY_FILE_PATH=./memory/data/memory.json
MEMORY_BACKUP_ENABLED=true
MEMORY_BACKUP_INTERVAL=3600000

# Database Configuration (if using external DB in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/memory_db
# REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-jwt-secret-key-here
API_KEY=your-api-key-here

# MCP Server Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Company Information
COMPANY_NAME=Superkraftmat AS
COMPANY_EMAIL=leonard@superkraftmat.no