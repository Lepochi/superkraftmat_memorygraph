# Railway Production Environment Variables
USE_SQLITE=true
NODE_ENV=production
SQLITE_PATH=/app/memory/database/superkraft.db
PORT=8000

# CORS Configuration (Railway will inject the domain)
CORS_ORIGIN=https://$RAILWAY_PUBLIC_DOMAIN

# Database Settings
DB_CONNECTION_TIMEOUT=30000
DB_QUERY_TIMEOUT=10000
DB_MAX_CONNECTIONS=10

# Security Settings
SESSION_SECRET=your_production_session_secret_here
JWT_SECRET=your_production_jwt_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# Feature Flags
WEBSOCKET_ENABLED=true
API_V2_ENABLED=true